/Build/
# Generated benchmark reports and raw measurements stay local.
/docs/benchmark-results/
# Evidence archives (.tar.gz, .zip, .gz) stay local; commit their reports and manifests.
/docs/**/*.gz
/docs/**/*.tgz
/docs/**/*.zip
*.v3cc.*/
/tools/layout_corpus

# Compiled V test binaries dropped next to their _test.v source
*_test

# Root build output
/libweb_v

# Generated full-uBO snapshot metadata (the bundled gzip assets are tracked)
/tools/adblock/generated-defaults.js
/tools/adblock/snapshot-layout.json

# Local metadata, compiled binaries, captured pages and build snapshots
.DS_Store
/1.tmp
/vox2
/tools/pixel_diff
/march-build.app/
/uk.html
/pikabu_compositor*_production_snapshot.sh

# x.imp build state and the compiled build.v launcher
/.imp/
/build.exe

# Temporary and local files to ignore
**/__pycache__/

# Captured response bodies (binary)
Tests/Browser/Brave/archives/*/archive/bodies/
Tests/Browser/Brave/archives/*/capture-watchdog/archive/bodies/
Tests/Browser/Brave/sites/*/bodies/
