+// VOX_MSL_PRECISION_BEGIN
+// Preserve the previous two regex replacements, including word boundaries,
+// in one pass. Generated MSL can contain many thousands of tokens.
+static std::string vox_promote_msl_precision(std::string_view msl) {
+    auto word = [](char ch) {
+        return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+               (ch >= '0' && ch <= '9') || ch == '_';
+    };
+    auto dimension = [](char ch) { return ch >= '2' && ch <= '4'; };
+    std::string result;
+    result.reserve(msl.size());
+    for (size_t i = 0; i < msl.size();) {
+        if ((i == 0 || !word(msl[i - 1])) && msl.substr(i, 4) == "half") {
+            size_t end = i + 4;
+            if (end < msl.size() && dimension(msl[end])) {
+                ++end;
+                if (end + 1 < msl.size() && msl[end] == 'x' && dimension(msl[end + 1])) {
+                    end += 2;
+                }
+            }
+            if (end == msl.size() || !word(msl[end])) {
+                result.append("float");
+                result.append(msl.substr(i + 4, end - i - 4));
+                i = end;
+                continue;
+            }
+        }
+        char ch = msl[i];
+        if (ch == 'h' && i != 0 && msl[i - 1] >= '0' && msl[i - 1] <= '9' &&
+            (i + 1 == msl.size() || !word(msl[i + 1]))) {
+            ch = 'f';
+        }
+        result.push_back(ch);
+        ++i;
+    }
+    return result;
+}
+// VOX_MSL_PRECISION_END
 
