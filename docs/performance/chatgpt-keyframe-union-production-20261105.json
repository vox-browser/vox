  "verification_source": "import hashlib,json,statistics,zipfile\nfrom pathlib import Path\nroot=Path.cwd();perf=root/'docs/performance'\ndef load(p):return json.loads(p.read_text())\ndef ref(row):\n p=root/row['path'];b=p.read_bytes();assert hashlib.sha256(b).hexdigest()==row['sha256']and len(b)==row['bytes'];return p\nd=load(perf/'chatgpt-keyframe-union-production-20261105.json');assert d['complete']and d['diagnostic_valid']and d['matched_valid']and d['browser_captures']==12\nassert d['page_instruction_credit']==d['broad_cadence_after']==0 and not d['acceptance']and not d['broad_required']\nassert d['guard']['child_exit_code']==d['archive_guard']['child_exit_code']==0 and d['guard']['adoption_error']is None\ncontroller=load(ref(d['controller']));assert controller['production_before']==controller['production_after']==d['production']and all(r['exit']==0 for r in controller['rows'])\nfor key,count in [('diagnostic',4),('matched',8)]:\n p=load(ref(d[key]));assert p['complete']and p['identity_stable']and p['inputs_before']==p['inputs_after']and len(p['observations'])==count\n assert all(r['content_exact']and r['pixels_exact']and r['exit']==r['kernel_exit_status']==0 for r in p['observations'])\nassert statistics.median(r['upper']for r in d['control'])==d['control_median'];assert statistics.median(r['upper']for r in d['candidate'])==d['candidate_median']\nassert min(r['lower']for r in d['control'])-max(r['upper']for r in d['candidate'])==d['conservative_page_instruction_reduction']\nfocus=load(ref(d['focused_component']));assert focus['focused']['passed']and focus['focused_test_function_executions']==408\nfor n,h in focus['focused']['source_after'].items():assert hashlib.sha256((root/n).read_bytes()).hexdigest()==h\narchives={r['path']:r for r in d['evidence']};blobs=0\nprobe=load(perf/'chatgpt-native-counter-probe-rejected-20261105.json');assert not probe['complete']and probe['browser_captures']==probe['instruction_credit']==0 and probe['restore_guard']['child_exit_code']==probe['probe_guard']['child_exit_code']==1\narchives[probe['evidence']['path']]=probe['evidence']\nfor row in archives.values():\n with zipfile.ZipFile(ref(row))as z:\n  assert z.testzip()is None\n  for n in z.namelist():\n   if n.startswith('blobs/'):assert hashlib.sha256(z.read(n)).hexdigest()==n[6:];blobs+=1\n  for r in json.loads(z.read('index.json'))['entries'].values():assert len(z.read('blobs/'+r['sha256']))==r['bytes']\nprint(json.dumps(dict(archives=len(archives),blobs=blobs,production_captures=12,content_and_pixels=True,statistics_recomputed=True,focused_test_executions=408,followup_probe_captures=0,page_instruction_credit=0)))\n",
