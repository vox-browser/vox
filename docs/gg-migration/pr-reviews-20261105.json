  "findings_fixed": [
    {
      "priority": "P1",
      "finding": "Embedded Windows GL loader lacks GL_PACK_ALIGNMENT",
      "commit": "01a7922600",
      "validation": "Regression reproduces the C error, then passes with the definition; separate Windows GLCORE executable cross-compiles and links with MinGW."
    },
    {
      "priority": "P2",
      "finding": "Common text references Darwin-only declarations",
      "commit": "8e76b07a8f",
      "validation": "CoreText implementation isolated in Darwin files; common API and unsupported-platform implementations type-check for Linux/Windows; macOS text hashes retained."
    },
    {
      "priority": "P2",
      "finding": "DRRect fallback leaves save and difference clip active after errors",
      "commit": "50dad21400",
      "validation": "Regression reproduces save_count 2 instead of 1; defer unwinds only the internal save and subsequent draw inside the former hole records successfully."
    },
    {
      "priority": "P2",
      "finding": "CPU gradient text silently renders a solid color",
      "commit": "0b9adab99b",
      "validation": "Gradient paint returns an unsupported error before rendering; unchanged destination pixels verified."
    },
    {
      "priority": "P2",
      "finding": "16-bit draw-list depth wraps",
      "commit": "7b1b0ebb16",
      "validation": "65534 repeated-color draws recorded, next draw rejected unchanged; deferred clip consumes depth 65535; void trigger defers errors to flush."
    },
    {
      "priority": "P2",
      "finding": "Uniform cache/batches exceed shader declaration",
      "commit": "6ce199418c",
      "validation": "4096 distinct blocks accepted, new block rejected unchanged, reused paint accepted; pending clip matrices and both path steps reserved atomically; final batch upload guarded."
    },
    {
      "priority": "P2",
      "finding": "Text strikes and retained native fonts have unbounded ownership",
      "commit": "dbfcab86a1",
      "validation": "32-strike LRU; 256 glyphs/256 KiB masks per strike; 512-pixel mask dimension limit. Native contexts, copied fonts, masks, maps and arrays released on eviction/clear; typeface.free is idempotent and removes only its own strikes. Retain/release, LRU, regeneration and no-GC checks pass."
    }
  ],
