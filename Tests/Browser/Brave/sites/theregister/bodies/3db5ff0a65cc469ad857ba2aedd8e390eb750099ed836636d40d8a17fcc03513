            '__tab" data-tab="reading">Further Reading <span class="' +
            P +
            '__tab-count">' +
            readingLinks.length +
            '</span></button>'
          : '') +
        '</div>' +
        (qaLabel
          ? '<span class="' + P + '__qa-label">' + esc(qaLabel) + '</span>'
          : '') +
        '<div class="' +
        P +
        '__tab-panel ' +
        P +
        '__tab-panel--qa ' +
        P +
        '__tab-panel--active">' +
        '<div class="' +
        P +
        '__qa"><iframe src="' +
        esc(withMuted(qaIframeSrc)) +
        '" frameborder="0" scrolling="no" allowfullscreen></iframe></div>' +
        '</div>' +
        (hasReading
          ? '<div class="' +
            P +
            '__tab-panel ' +
            P +
            '__tab-panel--reading">' +
            '<div class="' +
            P +
            '__right-reading">' +
            buildReadingHtml() +
            '</div>' +
            '</div>'
          : '') +
        '</div>' +
        '</div>';
    } else if (hasReading) {
      html =
        '<div class="' +
        P +
        '__live ' +
        P +
        '__live--reading">' +
        headerTopHtml +
        '<div class="' +
        P +
        '__video-col">' +
        videoHtml +
        '</div>' +
        headerBodyHtml +
        buildSponsorHtml() +
        '<div class="' +
        P +
        '__reading-col">' +
        '<div class="' +
        P +
        '__tabs-bar">' +
        '<button class="' +
        P +
        '__tab ' +
        P +
        '__tab--active" data-tab="reading">Further Reading <span class="' +
        P +
        '__tab-count">' +
        readingLinks.length +
        '</span></button>' +
        '</div>' +
        '<div class="' +
        P +
        '__tab-panel ' +
        P +
        '__tab-panel--reading ' +
        P +
        '__tab-panel--active">' +
        buildReadingHtml() +
        '</div>' +
        '</div>' +
        '</div>';
    } else {
      html =
        '<div class="' +
        P +
        '__live">' +
        headerTopHtml +
        headerBodyHtml +
        videoHtml +
        buildSponsorHtml() +
        '</div>';
    }

    container.innerHTML = wrap(html);

    // Wire further-reading scroll fade
    var scrollUpdaters = [];
    Array.prototype.forEach.call(
      container.querySelectorAll(
        '.' +
          P +
          '__tab-panel--reading .' +
          P +
          '__links,.' +
          P +
          '__right-reading .' +
          P +
          '__links'
      ),
      function (list) {
        var reading = list.parentNode;
        function update() {
          var atEnd =
            list.scrollHeight <= list.clientHeight ||
            list.scrollTop + list.clientHeight >= list.scrollHeight - 4;
          if (atEnd) {
            reading.classList.add(P + '__reading--scrolled-end');
          } else {
            reading.classList.remove(P + '__reading--scrolled-end');
          }
        }
        update();
        scrollUpdaters.push(update);
        list.addEventListener('scroll', update);
      }
    );

    // Sync reading-col max-height to the intrinsic video height so overflow-y:auto triggers.
    // Must measure __video (the 56.25% padding-bottom element) not __video-col, because the
    // grid stretches __video-col to match the sidebar content height — creating a circular loop.
    var videoEl = container.querySelector('.' + P + '__video');
    var readingColEl = container.querySelector('.' + P + '__reading-col');
    if (videoEl && readingColEl) {
      function syncReadingHeight() {
        // Only constrain height in the desktop grid layout (sidebar beside video).
        // On mobile the layout is a flex column and the reading col should flow freely.
        if (window.innerWidth <= 600) {
          readingColEl.style.maxHeight = '';
          return;
        }
        var h = videoEl.offsetHeight;
        if (h > 0) readingColEl.style.maxHeight = h + 'px';
      }
      requestAnimationFrame(syncReadingHeight);
      if (typeof ResizeObserver !== 'undefined') {
        new ResizeObserver(syncReadingHeight).observe(videoEl);
      } else {
        window.addEventListener('resize', syncReadingHeight);
      }
    }

    // Wire mobile tab switching
    var tabsBar = container.querySelector('.' + P + '__tabs-bar');
    if (tabsBar) {
      tabsBar.addEventListener('click', function (e) {
        var btn = e.target;
        while (btn && btn !== tabsBar && !btn.getAttribute('data-tab')) {
          btn = btn.parentNode;
        }
        var tab = btn && btn.getAttribute('data-tab');
        if (!tab) return;
        var rightCol = tabsBar.parentNode;
        Array.prototype.forEach.call(
          tabsBar.querySelectorAll('.' + P + '__tab'),
          function (t) {
            t.classList.toggle(P + '__tab--active', t === btn);
          }
        );
        Array.prototype.forEach.call(
          rightCol.querySelectorAll('.' + P + '__tab-panel'),
          function (panel) {
            panel.classList.toggle(
              P + '__tab-panel--active',
              panel.classList.contains(P + '__tab-panel--' + tab)
            );
          }
        );
        if (tab === 'reading') {
          requestAnimationFrame(function () {
            for (var i = 0; i < scrollUpdaters.length; i++) scrollUpdaters[i]();
          });
        }
      });
    }
  }
  function showUpcoming(w) {
    var startMs = new Date(w.date).getTime();
    var subtypeDisplay = w.subtype ? w.subtype.replace(/[_-]/g, ' ') : '';
    var liveLabel = ('Live ' + (subtypeDisplay || 'webcast')).toUpperCase();
    var registerUrl = w.id
      ? 'https://intelligence.theregister.com/paper/view/' +
        encodeURIComponent(w.id)
      : '';

    function tileHtml(key, unit) {
      return (
        '<li class="' +
        P +
        '__ev-tile"><span class="' +
        P +
        '__ev-num" data-ev-' +
        key +
        '>00</span><span class="' +
        P +
        '__ev-unit">' +
        unit +
        '</span></li>'
      );
    }
    var countHtml =
      '<div class="' +
      P +
      '__ev-count" role="timer" aria-live="off"><span class="' +
      P +
      '__ev-count-label" data-ev-label>STARTS IN</span><ul class="' +
      P +
      '__ev-tiles">' +
      tileHtml('days', 'DAYS') +
      tileHtml('hours', 'HRS') +
      tileHtml('mins', 'MIN') +
      '</ul></div>';
    var actionsHtml = registerUrl
      ? '<div class="' +
        P +
        '__ev-actions"><a class="' +
        P +
        '__ev-cta" href="' +
        esc(registerUrl) +
        '" target="_blank" rel="noopener noreferrer">Save my seat' +
        ARROW_SVG +
        '</a></div>'
      : '';

    container.innerHTML = wrap(
      eventUnitHtml(
        '',
        eventStripHtml(liveLabel, w.date) +
          '<div class="' +
          P +
          '__ev-body"><div class="' +
          P +
          '__ev-main">' +
          eventTitleHtml(w) +
          eventDescHtml(summarise(w.synopsisText)) +
          '</div><div class="' +
          P +
          '__ev-side">' +
          countHtml +
          actionsHtml +
          '</div></div>'
      )
    );

    var unitEl = container.querySelector('.' + P + '__ev');
    function pad(n) {
      return n < 10 ? '0' + n : String(n);
    }
    function set(sel, text) {
      var el = unitEl.querySelector(sel);
      if (el) el.textContent = text;
    }
    function tick() {
      var diff = Math.max(0, startMs - Date.now());
      // Round up so the final minute reads 00 00 01, not 00 00 00
      var totalMins = Math.ceil(diff / 6e4);
      set('[data-ev-days]', pad(Math.floor(totalMins / 1440)));
      set('[data-ev-hours]', pad(Math.floor((totalMins % 1440) / 60)));
      set('[data-ev-mins]', pad(totalMins % 60));
      set('[data-ev-label]', diff > 0 ? 'STARTS IN' : 'HAPPENING NOW');
      if (diff === 0 && countdownTimer) {
        clearInterval(countdownTimer);
        countdownTimer = null;
      }
    }
    tick();
    if (startMs > Date.now()) {
      countdownTimer = setInterval(tick, COUNTDOWN_TICK_MS);
    }
  }
  function render(w) {
    if (countdownTimer) {
      clearInterval(countdownTimer);
      countdownTimer = null;
    }
    if (w.iframeHtml) {
      showIframe(w);
    } else if (w.date) {
      var now = Date.now();
      var startMs = new Date(w.date).getTime();
      var endMs = startMs + (w.duration || 0) * 60 * 1000;
      if (now < endMs) {
        showUpcoming(w);
      } else {
        showEnded(w);
      }
    } else {
      showEmpty();
    }
  }

  function scheduleRefresh(w) {
    if (pollTimer) {
      clearTimeout(pollTimer);
      pollTimer = null;
    }
    if (!w.date) return;
    var now = Date.now();
    var startMs = new Date(w.date).getTime();
    var endMs = startMs + (w.duration || 0) * 60 * 1000;
    if (now >= endMs) return;
    var delay;
    if (w.iframeHtml) {
      delay = endMs - now;
    } else if (startMs - now <= PRESHOW_MS) {
      delay = PRESHOW_POLL_MS;
    } else {
      delay = startMs - PRESHOW_MS - now;
    }
    pollTimer = setTimeout(fetchAndRender, delay);
  }

  function fetchAndRender() {
    var qs = [];
    if (dataId) qs.push('id=' + encodeURIComponent(dataId));
    if (dataType) qs.push('type=' + encodeURIComponent(dataType));
    fetch(
      baseUrl + '/api/asset/webcast' + (qs.length ? '?' + qs.join('&') : '')
    )
      .then(function (res) {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        return res.json();
      })
      .then(function (data) {
        if (!data || typeof data !== 'object') {
          showEmpty();
          return;
        }
        render(data);
        scheduleRefresh(data);
      })
      .catch(function () {
        showEmpty();
      });
  }

  function init() {
    if (!container) return;
    injectStyles();
    fetchAndRender();
  }
  init();
})();
