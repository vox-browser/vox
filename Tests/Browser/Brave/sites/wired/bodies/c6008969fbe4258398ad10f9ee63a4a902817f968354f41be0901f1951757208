  }

  .campaign-coupons-container__nav-button--next {
    right: 0;
  }

  .campaign-coupons-container__nav-button--prev {
    left: 0;
  }

  @media (max-width: 1200px) {
    .campaign-coupons-container__row-wrapper {
      width: calc(100% + 24px);
    }

    .campaign-coupons-container__navigation {
      margin: -76px 24px 52px 0;
    }
  }

  @media (max-width: 768px) {
