    flex-direction: column-reverse;
    padding: 0;
    width: calc(100% + 64px);
  }

  .campaign-coupons-container__navigation {
    display: flex;
    flex-direction: row;
    align-self: flex-end;
    margin: -76px 64px 52px 0;
  }

  .campaign-coupons-container__pagination {
