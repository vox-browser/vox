	<h2 class="story">
		

		

		
		

		

		

		

		<span id="title-186541157" class="story-title"> <a onclick="return toggle_fh_body_wrap_return(this);" href="//games.slashdot.org/story/26/11/01/0431200/xbox-manager-ai-already-being-used-in-xbox-game-development---and-throughout-the-game-industry">Xbox Manager: AI Already Being Used In Xbox Game Development - And Throughout the Game Industry</a> <span class=" no extlnk"><a class="story-sourcelnk" href="https://www.engadget.com/2302431/brandon-stirrup-xbox-manager-says-ai-used-game-development/" title="External link - https://www.engadget.com/2302431/brandon-stirrup-xbox-manager-says-ai-used-game-development/" target="_blank"> (engadget.com) </a></span></span>

		
		
		<!--<span class="comments commentcnt-186541157" >41</span>-->
		

		
		<!-- comment bubble -->
		
			<span class="comment-bubble"><a href="//games.slashdot.org/story/26/11/01/0431200/xbox-manager-ai-already-being-used-in-xbox-game-development---and-throughout-the-game-industry#comments" title="">41</a></span>
		
	</h2>
	<div class="details" id="details-186541157">
		<span class="story-details">
		<span class="story-views">
			<span class="sodify" onclick="firehose_set_options('color', 'red')" title="Filter Firehose to entries rated red or better"></span><span class="icon-beaker pop1 " alt="Popularity" title="Filter Firehose to entries rated red or better" onclick="firehose_set_options('color', 'red')"><span></span></span> 
		</span>
